{
  "name": "@local/moyu-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "摸鱼鼓励师：在会话右上角实时显示每秒工资入账。",
  "author": "easpeeder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/easpeeder/moyu-coach.git"
  },
  "homepage": "https://github.com/easpeeder/moyu-coach#readme",
  "bugs": {
    "url": "https://github.com/easpeeder/moyu-coach/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "salary",
    "widget"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
